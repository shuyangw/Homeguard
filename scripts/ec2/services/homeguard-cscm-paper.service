[Unit]
Description=Homeguard CSCM Paper Trading - Cross-Sectional Crypto Momentum
Documentation=https://github.com/anthropics/claude-code
After=network.target
PartOf=homeguard-trading.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/Homeguard

# Environment
Environment="PATH=/home/ec2-user/Homeguard/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/ec2-user/Homeguard"
Environment="PYTHONUNBUFFERED=1"

# Main command
ExecStart=/home/ec2-user/Homeguard/venv/bin/python scripts/trading/run_cscm_paper.py --check-interval 60

# Restart policy
Restart=always
RestartSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homeguard-cscm-paper

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Security
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=homeguard-trading.target
