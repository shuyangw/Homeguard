{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "WebSocket Connected",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "hg_websocket_connected",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "disconnected", "color": "red", "index": 0},
                "1": {"text": "connected", "color": "green", "index": 1}
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 2,
      "title": "Broker Heartbeat Age (s)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "time() - hg_broker_last_heartbeat_timestamp",
          "legendFormat": "{{broker}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 60},
              {"color": "red", "value": 300}
            ]
          }
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 3,
      "title": "Order Rejection Rate (5m)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "rate(hg_orders_rejected_total[5m])",
          "legendFormat": "Rejection Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "cps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 4,
      "title": "Process RSS by Strategy",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "hg_process_rss_bytes",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 5,
      "title": "RAMP Cache Age (s)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "hg_ramp_cache_age_seconds",
          "legendFormat": "RAMP Cache Age",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 3600},
              {"color": "red", "value": 86400}
            ]
          }
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["homeguard"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Infrastructure Health",
  "uid": "homeguard-infra",
  "version": 2,
  "weekStart": ""
}
