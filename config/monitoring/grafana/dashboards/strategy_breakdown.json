{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Realized P&L by Strategy",
      "description": "Today's realized P&L per strategy, aggregated from the trade-log JSONL (sum of `pnl_dollars` where `trade_type == 'exit'` and `strategy == <s>`). Resets each trading day. Does NOT include mark-to-market on open positions (see Unrealized panel). Updated every ~30s by the strategy sidecar.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_realized_pnl_usd",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "axisCenteredZero": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "Unrealized P&L by Strategy",
      "description": "Mark-to-market P&L across all currently-open positions per strategy. Derived from `(current_price - avg_entry_price) * qty`, summed per strategy. Source: `hg_strategy_unrealized_pnl_usd`, emitted per-tick. Zero when the strategy is fully in cash. Y-axis centered on $0.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_unrealized_pnl_usd",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "axisCenteredZero": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Position Count by Strategy",
      "description": "Number of open positions per strategy. Source: `hg_strategy_positions_count` = `len(broker.get_crypto_positions())` for CSCM / `len(state_manager.get_positions(strategy))` for OMR/RAMP/MP. Zero = strategy is flat (full cash).",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_positions_count",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "Decision Age (seconds)",
      "description": "Seconds since the strategy's last recorded decision. Source: `time() - hg_strategy_last_decision_timestamp`, where the timestamp is the mtime of `data/trading/decisions/_latest/<strategy>.json` -- written by the decision-log every time a strategy trigger fires. Expected to grow large for low-cadence strategies (RAMP fires once per trading day; CSCM weekly). Green < 1d, yellow 1-7d, red > 7d. For process-liveness (is the sidecar emitting at all?) see the 'Tick Age' column on Portfolio Overview's Strategy Status table.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - hg_strategy_last_decision_timestamp",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 86400
              },
              {
                "color": "red",
                "value": 604800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "Strategy Capital (Deployed vs Starting)",
      "description": "Solid line = capital deployed into open positions (`hg_strategy_capital_allocated_usd` = sum of position market values). Dashed line = strategy's starting capital budget (`hg_strategy_initial_capital_usd`, emitted once at startup). The gap between the two lines is idle cash. If deployed stays near zero but the strategy is meant to be active, something is gating rebalances (BEAR regime, trailing stop, momentum filter).",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_capital_allocated_usd",
          "legendFormat": "{{strategy}} deployed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_initial_capital_usd",
          "legendFormat": "{{strategy}} starting",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* starting"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Per-Symbol Unrealized PnL",
      "description": "Unrealized P&L attributed to each individual open position over time, legend-formatted as `strategy:symbol`. Source: `hg_position_unrealized_pnl_usd` per symbol. Use this to see which position is driving a strategy's aggregate P&L.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_position_unrealized_pnl_usd",
          "legendFormat": "{{strategy}}:{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "axisCenteredZero": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "refresh": "30s",
