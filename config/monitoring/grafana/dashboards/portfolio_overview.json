            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_realized_pnl_usd",
          "legendFormat": "{{strategy}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 0}
            ]
          },
          "color": {
