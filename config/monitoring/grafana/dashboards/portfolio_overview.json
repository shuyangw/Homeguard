{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Equity Curve",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "max(hg_portfolio_equity_usd) by (broker)",
          "legendFormat": "{{broker}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 2,
      "title": "Drawdown % by Strategy",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "hg_portfolio_drawdown_pct",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": -20},
              {"color": "green", "value": -5}
            ]
          }
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "title": "Day P&L (USD)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "sum(hg_portfolio_day_pnl_usd)",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "hg_portfolio_day_pnl_usd",
          "legendFormat": "{{job}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "custom": {"axisCenteredZero": true}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "title": "Regime State Code",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "max(hg_regime_state_code)",
          "legendFormat": "Regime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 4,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "STRONG_BULL", "color": "green", "index": 0},
                "1": {"text": "WEAK_BULL", "color": "light-green", "index": 1},
                "2": {"text": "SIDEWAYS", "color": "yellow", "index": 2},
                "3": {"text": "UNPREDICTABLE", "color": "orange", "index": 3},
                "4": {"text": "BEAR", "color": "red", "index": 4}
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["homeguard"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Portfolio Overview",
  "uid": "homeguard-portfolio",
  "version": 2,
  "weekStart": ""
}
