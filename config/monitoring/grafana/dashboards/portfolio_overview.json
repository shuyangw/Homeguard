  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 10,
      "title": "Strategy Status",
      "description": "Single-row-per-strategy snapshot of all live trading strategies. Strategy-agnostic by design -- adding a new strategy adds a row, never a panel. Composed entirely of existing per-strategy metrics; no new emissions required. Columns: Equity ($), Starting capital ($), Deployed ($) = sum of position market values, Idle = Equity - Deployed, Positions = open count, Tick Age (s) = `time() - hg_strategy_last_signal_timestamp` (process-liveness; red >300s indicates a hung sidecar), Decision Age = `time() - hg_strategy_last_decision_timestamp` (mtime of the decision-log _latest snapshot; expected high for low-cadence strategies like CSCM weekly rebalance). For strategy-specific 'why not deploying' detail, drill into the decision log via `python -m src.trading.decision_log` or the Service Logs panel on Incident Review.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_equity_usd",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_initial_capital_usd",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_capital_allocated_usd",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_positions_count",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - hg_strategy_last_signal_timestamp",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - hg_strategy_last_decision_timestamp",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "strategy",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Idle",
            "mode": "binary",
            "binary": {
              "left": "Value #A",
              "operator": "-",
              "right": "Value #C"
            },
            "reduce": {"reducer": "sum"},
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "__name__ 5": true,
              "__name__ 6": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "job 5": true,
              "job 6": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "instance 5": true,
              "instance 6": true
            },
            "renameByName": {
              "strategy": "Strategy",
              "Value #A": "Equity ($)",
              "Value #B": "Starting ($)",
              "Value #C": "Deployed ($)",
              "Value #D": "Positions",
              "Value #E": "Tick Age (s)",
              "Value #F": "Decision Age (s)"
            },
            "indexByName": {
              "Strategy": 0,
              "Equity ($)": 1,
              "Starting ($)": 2,
              "Deployed ($)": 3,
              "Idle": 4,
              "Positions": 5,
              "Tick Age (s)": 6,
              "Decision Age (s)": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Equity ($)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Starting ($)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Deployed ($)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Positions"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Idle"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tick Age (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Decision Age (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 86400
                    },
                    {
                      "color": "red",
                      "value": 604800
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 1,
      "title": "Equity Curve by Strategy",
      "description": "Current equity per live strategy over time, with starting capital as a dashed reference line. Source: `hg_strategy_equity_usd` (solid). For strategies that share a broker account (RAMP on IBKR paper) this is `initial_capital + sum(attributed_unrealized_pnl)` via `_compute_strategy_equity` -- the strategy slice, not the whole broker portfolio. For strategies with a dedicated broker (CSCM on DemoBroker) it equals `broker.get_account().portfolio_value` because no other strategy shares the account. `hg_strategy_initial_capital_usd` (dashed) is the session's starting budget, emitted once at startup. Log Y-axis accommodates strategies with different funding sizes. If a strategy line stops updating, that strategy's process is hung.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_equity_usd",
          "legendFormat": "{{strategy}} equity",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_initial_capital_usd",
          "legendFormat": "{{strategy}} starting",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* starting"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Drawdown % by Strategy",
      "description": "One line per strategy. Drawdown is derived in PromQL from `hg_strategy_equity_usd` history: (equity - peak) / peak * 100, where peak = max_over_time(equity[$__range]). The peak window matches the panel's visible time range, so drawdown is 'drawdown from the highest equity in the period you're viewing' -- zooming out widens the lookback. No separate drawdown gauge is emitted and no peak is persisted; the equity gauge is the single source of truth. Always <= 0. Green > -5%, yellow -5% to -20%, red < -20%.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "clamp_max((hg_strategy_equity_usd - max_over_time(hg_strategy_equity_usd[$__range])) / max_over_time(hg_strategy_equity_usd[$__range]) * 100, 0)",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": -20
              },
              {
                "color": "green",
                "value": -5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Day P&L (USD)",
      "description": "Per-strategy P&L since the start of the visible time range, plus a summed 'Total' across strategies. Derived in PromQL from `hg_strategy_equity_usd` history: `equity - first_over_time(equity[$__range])`. The window matches the panel's visible time range, so 'now-6h' shows 6-hour P&L; 'now-1d' shows day P&L. No separate Day-PnL gauge is emitted -- the strategy_equity gauge is the single source of truth. The legacy broker-level `hg_portfolio_day_pnl_usd` is still emitted but no panel reads it -- it conflates broker portfolio drift with strategy P&L when strategies share an account.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(hg_strategy_equity_usd - first_over_time(hg_strategy_equity_usd[$__range]))",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_strategy_equity_usd - first_over_time(hg_strategy_equity_usd[$__range])",
          "legendFormat": "{{strategy}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "axisCenteredZero": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "RAMP Regime State Code",
      "description": "Current US-equities market regime classified by MarketRegimeDetector (src/strategies/advanced/market_regime_detector.py). Values: 1=STRONG_BULL (low vol, positive momentum), 2=WEAK_BULL, 3=SIDEWAYS, 4=UNPREDICTABLE (elevated vol, ambiguous trend), 5=BEAR. **RAMP-only signal** -- CSCM does not contribute to this panel because it uses a binary BTC>SMA40 gate over crypto markets (a fundamentally different regime concept on a different asset class), not the 5-state classifier.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(hg_regime_state_code)",
          "legendFormat": "Regime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 1,
          "max": 5,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "STRONG_BULL",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "WEAK_BULL",
                  "color": "light-green",
                  "index": 1
                },
                "3": {
                  "text": "SIDEWAYS",
                  "color": "yellow",
                  "index": 2
                },
                "4": {
                  "text": "UNPREDICTABLE",
                  "color": "orange",
                  "index": 3
                },
                "5": {
                  "text": "BEAR",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 11,
      "title": "Current Positions",
      "description": "Instant snapshot of every open position across all strategies. Columns: Strategy, Symbol, Quantity, Unrealized PnL (color-coded red/green by sign). Sources: `hg_position_qty` and `hg_position_unrealized_pnl_usd`, joined by `symbol`. ASSUMPTION: no two strategies hold the same ticker concurrently (RAMP=stocks, CSCM=crypto, OMR=leveraged ETFs -- no overlap). If a future strategy violates that, this panel will collapse rows; switch the transformation to a multi-label join then.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_position_qty",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "hg_position_unrealized_pnl_usd",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "symbol",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "job 1": true,
              "job 2": true,
              "instance 1": true,
              "instance 2": true,
              "strategy 2": true
            },
            "renameByName": {
              "Value #A": "Quantity",
              "Value #B": "Unrealized PnL",
              "symbol": "Symbol",
              "strategy 1": "Strategy"
            },
            "indexByName": {
              "Strategy": 0,
              "Symbol": 1,
              "Quantity": 2,
              "Unrealized PnL": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Unrealized PnL"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "title": "Today's Realized P&L",
      "description": "Per-strategy realized P&L since midnight ET, anchored to today's session boundary. One value per strategy. Source: `hg_strategy_realized_pnl_usd` (today gauge), computed by summing `pnl_dollars` on `exit` rows in today's `trades_*.jsonl`. Resets at midnight ET regardless of dashboard time range -- this is by design (the today gauge has fixed-boundary semantics; for range-relative views see the `Realized P&L by Strategy` time series on Strategy Breakdown).",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
