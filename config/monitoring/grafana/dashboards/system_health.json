{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage (%)",
      "description": "EC2 host CPU utilization as a percentage (100 - idle). Source: `node_cpu_seconds_total` from node_exporter. Averaged across all cores over a 5-minute window. Green < 70%, yellow 70-90%, red > 90%. Sustained high usage suggests a strategy is compute-bound (regime detection, big-universe scans).",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          }
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 2,
      "title": "Memory Usage (%)",
      "description": "EC2 host memory usage as a percentage of total RAM. Source: `100 * (1 - MemAvailable / MemTotal)` from node_exporter. Excludes filesystem caches from 'used'. Green < 75%, yellow 75-90%, red > 90%. Ties to `MemoryMax` limits on each systemd unit if you need to diagnose per-strategy pressure.",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "Memory %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 75},
              {"color": "red", "value": 90}
            ]
          }
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 3,
      "title": "Memory Breakdown",
      "description": "Absolute bytes split across Used (MemTotal - MemAvailable), Cached (filesystem cache, reclaimable), and Free. Source: node_exporter `node_memory_*`. Use to distinguish genuine memory pressure from harmless cache growth.",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "node_memory_Cached_bytes",
          "legendFormat": "Cached",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "node_memory_MemFree_bytes",
          "legendFormat": "Free",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 4,
      "title": "Load Average",
      "description": "Linux 1/5/15-minute load averages. Source: `node_load1`, `node_load5`, `node_load15`. Load > CPU core count sustained means the host is oversubscribed. t4g.medium has 2 vCPUs so loads > 2 are worth investigating.",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "node_load1",
          "legendFormat": "1m",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "node_load5",
          "legendFormat": "5m",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "node_load15",
          "legendFormat": "15m",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 5,
      "title": "Disk Usage by Mount (%)",
      "description": "Disk usage per mountpoint excluding tmpfs/overlay/squashfs. Source: `node_filesystem_size_bytes` / `node_filesystem_avail_bytes`. Green < 80%, yellow 80-90%, red > 90%. `/` filling up is most often journald (see `journalctl --disk-usage`) or VictoriaMetrics data (retention 90d).",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"}))",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 90}
            ]
          }
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 6,
      "title": "Network Throughput",
      "description": "Per-interface rx/tx throughput in bytes-per-second (5m rate). Source: `rate(node_network_receive_bytes_total)` and `rate(node_network_transmit_bytes_total)`. Steady baseline = monitoring + Alpaca WebSocket. Spikes = rebalance windows or historical-data backfills.",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "rate(node_network_receive_bytes_total[5m])",
          "legendFormat": "{{device}} rx",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "rate(node_network_transmit_bytes_total[5m])",
          "legendFormat": "{{device}} tx",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 7,
      "title": "Uptime",
      "description": "Seconds since last EC2 boot. Source: `time() - node_boot_time_seconds`. Unexpectedly low = instance was rebooted (check CloudWatch for auto-stop/start windows).",
      "type": "stat",
      "gridPos": {"x": 0, "y": 24, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "time() - node_boot_time_seconds",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "auto"}
    },
    {
      "id": 8,
      "title": "CPU Cores",
      "description": "Logical CPU core count detected by node_exporter. t4g.medium = 2 cores. Use to contextualize load-average readings.",
      "type": "stat",
      "gridPos": {"x": 6, "y": 24, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "count(count(node_cpu_seconds_total) by (cpu))",
          "legendFormat": "Cores",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "auto"}
    },
    {
      "id": 9,
      "title": "Total RAM",
      "description": "Total physical memory. Source: `node_memory_MemTotal_bytes`. t4g.medium = 4 GiB.",
      "type": "stat",
      "gridPos": {"x": 12, "y": 24, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "auto"}
    },
    {
      "id": 10,
      "title": "Disk I/O",
      "description": "Per-device read/write throughput in bytes-per-second (5m rate). Source: `rate(node_disk_{read,written}_bytes_total)`. Large write spikes correlate with VictoriaMetrics compaction or strategy state snapshots.",
      "type": "timeseries",
      "gridPos": {"x": 18, "y": 24, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "rate(node_disk_read_bytes_total[5m])",
          "legendFormat": "{{device}} read",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "expr": "rate(node_disk_written_bytes_total[5m])",
          "legendFormat": "{{device}} write",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["homeguard", "system"],
