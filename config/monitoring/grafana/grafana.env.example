# Template for /etc/homeguard/grafana.env on the EC2 host.
#
# Grafana reads this via EnvironmentFile in
# infra/ec2/services/grafana-server.service, and interpolates ${VAR} references
# in provisioning files (config/monitoring/grafana/alerting/*.yaml).
#
# The real file lives ONLY on the host and is never committed. Install it with:
#
#   ssh ec2-user@homeguard-ec2
#   sudo install -m 640 -o root -g grafana /dev/null /etc/homeguard/grafana.env
#   sudo tee /etc/homeguard/grafana.env >/dev/null <<'EOF'
#   DISCORD_MONITORING_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>
#   EOF
#   sudo systemctl restart grafana-server
#
# Mode 640 root:grafana so only root and the grafana service can read it.
#
# To create the webhook: Discord -> Server Settings -> Integrations -> Webhooks
# -> New Webhook -> pick a channel -> Copy Webhook URL.
#
# Treat the URL as a credential: anyone holding it can post to that channel.
# Rotate by deleting the webhook in Discord and creating a new one.

# Target channel for Grafana alert notifications.
DISCORD_MONITORING_WEBHOOK=<YOUR_DISCORD_WEBHOOK_URL>

# NOTE: scripts/monitoring/weekly_report.py reads a variable of the same name
# from the repo .env for its weekly QuantStats post. That one is currently UNSET,
# which is why the weekly report has never been delivered. The same webhook URL
# can be used for both; set it in the repo .env as well if you want the weekly
# report to start posting.
