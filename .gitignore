# ============================================================================
# DOCUMENTATION - Hide all except architecture
# ============================================================================
# Hide all docs by default
docs/*

# KEEP: Main documentation navigation
!docs/README.md

# KEEP: Architecture documentation (critical for developers)
!docs/architecture/
!docs/architecture/**

# KEEP: Strategy documentation (production strategy details)
!docs/strategies/
!docs/strategies/**

# KEEP: Session work logs (implementation summaries for cross-session recall)
!docs/progress/
!docs/progress/**

# KEEP: Troubleshooting documentation (production issue analysis)
!docs/troubleshooting/
!docs/troubleshooting/**

# KEEP: Reference docs (developer/operator references)
!docs/reference/
!docs/reference/**

# KEEP: Guidelines (backtesting standards, coding guidelines)
!docs/guidelines/
!docs/guidelines/**

# KEEP: Monitoring system documentation (metric specs, infra configs)
!docs/monitoring/
!docs/monitoring/**

# KEEP: Storage / data schema documentation
!docs/storage/
!docs/storage/**

# Hide everything else (new files only - previously tracked files remain):
# - docs/api/ (can be generated from code)
# - docs/guides/ (user guides, wiki material)
# - docs/testing/ (test documentation)
# - docs/progress/ (historical tracking)
# - docs/quantstats/ (integration-specific)
# - docs/reports/ (backtest reports, generated output)
# - docs/archive/ (archived legacy documentation - local only)
# - docs/planning/ (implementation plans)
# - docs/*.md (misc root-level docs)

# ============================================================================
# EXPERIMENTAL BACKTEST CONFIGS (Keep only baselines)
# ============================================================================
# Parameter sweep variants (alt1, alt2, test1, test2, option_a, etc.)
config/backtesting/*_alt[0-9]*.yaml
config/backtesting/*_test[0-9]*.yaml
config/backtesting/*_option_*.yaml
config/backtesting/*_micro_*.yaml

# ML Crypto Mean Reversion variants (keep baseline and walk_forward only)
config/backtesting/ml_crypto_mr_*.yaml
!config/backtesting/ml_crypto_mr_baseline.yaml
!config/backtesting/ml_crypto_mr_walk_forward.yaml

# BMSB variants (keep baseline only)
config/backtesting/bmsb_crypto_*.yaml
!config/backtesting/bmsb_crypto.yaml

# ICT research configs (shelved strategy - archive in git, don't track variants)
config/backtesting/ict_crypto_*.yaml
config/backtesting/ict_test2_*.yaml
config/backtesting/ict_ict_*.yaml

# ORB extended variants
config/backtesting/orb_leveraged_*.yaml
config/backtesting/orb_sp500_*.yaml

# HV_ORB batch and symbol variants (keep baseline configs)
config/backtesting/hv_orb_*_symbols.yaml
config/backtesting/hv_orb_batch*.yaml
config/backtesting/hv_orb_top*.yaml

