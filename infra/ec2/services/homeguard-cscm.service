[Unit]
Description=Homeguard CSCM Strategy - Cross-Sectional Crypto Momentum
After=network.target
PartOf=homeguard-trading.target
Conflicts=homeguard-trading.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/Homeguard
Environment="PATH=/home/ec2-user/Homeguard/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="ENABLE_METRICS=true"
Environment="METRICS_PORT=8084"
Environment="CSCM_USE_DEMO_BROKER=true"
ExecStart=/home/ec2-user/Homeguard/venv/bin/python scripts/trading/run_cscm_live.py --check-interval 0.0833 --initial-capital 100000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homeguard-cscm

# Resource limits
MemoryMax=512M
CPUQuota=75%

[Install]
WantedBy=homeguard-trading.target
