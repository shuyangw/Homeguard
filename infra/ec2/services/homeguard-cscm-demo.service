[Unit]
Description=Homeguard CSCM Demo Trading - Binance Streaming
After=network.target
Documentation=https://github.com/homeguard/trading

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/Homeguard
Environment="PATH=/home/ec2-user/Homeguard/venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/ec2-user/Homeguard/venv/bin/python scripts/trading/run_cscm_demo.py

# Restart policy
Restart=always
RestartSec=30

# Resource limits
MemoryMax=768M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cscm-demo

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/Homeguard
ReadWritePaths=/home/ec2-user/.homeguard

[Install]
WantedBy=homeguard-trading.target
WantedBy=multi-user.target
