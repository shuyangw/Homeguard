[Unit]
Description=IB Gateway via IBC (automated login)
After=network-online.target homeguard-xvfb.service
Requires=homeguard-xvfb.service
Before=homeguard-trading.target

# Moved here from [Service], where systemd silently ignored them
# ("Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring").
# These are [Unit] directives, so the intended crash-loop cap was never in
# effect. With RestartSec=60, the interval must exceed burst x RestartSec
# (5 x 60s = 300s) to be reachable; 600s leaves headroom.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user

# Source credentials from .env
EnvironmentFile=/home/ec2-user/Homeguard/.env
Environment="DISPLAY=:1"

# Render IBC config from template (resolve env vars), then launch Gateway
ExecStartPre=/bin/bash -c 'envsubst < /home/ec2-user/Homeguard/config/ibkr/ibc-config.ini.template > /home/ec2-user/ibc-config.ini'
ExecStart=/opt/ibc/scripts/ibcstart.sh 1037 -g \
    --tws-path=/home/ec2-user/Jts \
    --ibc-ini=/home/ec2-user/ibc-config.ini \
    --java-path=/usr/lib/jvm/bellsoft-java17-full.aarch64/bin

Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homeguard-gateway

# Memory limit (Gateway only, Xvfb is separate)
MemoryMax=640M

[Install]
WantedBy=homeguard-trading.target
