[Unit]
Description=Homeguard Multi-Strategy Trading Bot (pinned to RAMP)
After=network.target homeguard-gateway.service
Wants=homeguard-gateway.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/Homeguard
Environment="PATH=/home/ec2-user/Homeguard/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="ENABLE_METRICS=true"
Environment="METRICS_PORT=8082"
# Wait up to 120s for IBKR gateway to bind port 4002. Without this, a fresh
# boot races the Java+IBC login (~10s) and the broker factory falls back to
# Alpaca on ConnectionRefusedError.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do /usr/sbin/ss -ltn sport = :4002 | grep -q :4002 && exit 0; sleep 2; done; echo "gateway 4002 did not bind in 120s"; exit 1'
ExecStart=/home/ec2-user/Homeguard/venv/bin/python scripts/trading/run_live_paper_trading.py --strategy ramp
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homeguard-multi

[Install]
WantedBy=multi-user.target
