# ============================================================================
# ALPACA PAPER TRADING API
# ============================================================================
# Get your paper trading API keys from: https://alpaca.markets (Paper Trading section)
ALPACA_PAPER_BASE_URL="https://paper-api.alpaca.markets/v2"
ALPACA_PAPER_KEY_ID="your_paper_trading_key_id_here"
ALPACA_PAPER_SECRET_KEY="your_paper_trading_secret_key_here"

# For Alpaca market data retrieval (backward compatibility with existing data scripts)
API_KEY="your_alpaca_api_key_here"
API_SECRET="your_alpaca_api_secret_here"

# ============================================================================
# DISCORD BOT (Optional - for observability addon)
# ============================================================================
# Get your Discord bot token from: https://discord.com/developers/applications
# Create application > Bot tab > Reset Token > Copy token
DISCORD_TOKEN="your_discord_bot_token_here"

# Get your Anthropic API key from: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-api03-your_key_here"

# Channel restrictions (comma-separated Discord channel IDs)
# Leave empty to allow all channels the bot can see
# Get channel IDs: Discord settings > Advanced > Developer Mode ON, then right-click channel > Copy ID
ALLOWED_CHANNELS=""

# User restrictions (comma-separated Discord user IDs)
# Leave empty to allow all users
ALLOWED_USERS=""

# ============================================================================
# LIVE DATA STREAMING (Optional - Performance Optimization)
# ============================================================================
# Enable WebSocket streaming for real-time market data (replaces polling)
# Set to "true" to use LiveDataProvider (streaming), "false" for polling
# Default: false (backward compatible with existing deployments)
USE_STREAMING="false"

# Data feed for streaming (only used if USE_STREAMING=true)
# Options: "iex" (free, ~2-10% trades) or "sip" (paid, 100% trades)
# Recommendation: Use "iex" for paper trading, "sip" for production
STREAMING_FEED="iex"

# ============================================================================
# COINBASE ADVANCED TRADE API (for CSCM Crypto Strategy)
# ============================================================================
# Get your CDP API credentials from: https://www.coinbase.com/settings/api
# Create a new API key with "Trading" permissions
COINBASE_API_KEY="<YOUR_COINBASE_API_KEY>"
COINBASE_API_SECRET="<YOUR_COINBASE_API_SECRET>"

# ============================================================================
# THETADATA OPTIONS API (for OpEx Pinning Strategy)
# ============================================================================
# Theta Terminal connection settings (runs locally)
# Download Theta Terminal from: https://www.thetadata.net
THETADATA_HOST="127.0.0.1"
THETADATA_PORT_V2="25510"
THETADATA_PORT_V3="25503"

# ============================================================================
# EC2 INSTANCE CONFIGURATION (for scripts/ec2/ management scripts)
# ============================================================================
# Get these values from AWS Console or `terraform output`
EC2_IP="<YOUR_EC2_IP>"
EC2_INSTANCE_ID="<YOUR_INSTANCE_ID>"
EC2_REGION="us-east-1"
EC2_SSH_KEY_PATH="~/.ssh/homeguard-trading.pem"
EC2_USER="ec2-user"

# ============================================================================
# CSCM PAPER TRADING (Discord + Binance Data)
# ============================================================================
# Discord bot for CSCM paper trading status commands
# Create application at: https://discord.com/developers/applications
# Required permissions: applications.commands (slash commands)
DISCORD_CSCM_TOKEN="<YOUR_DISCORD_CSCM_BOT_TOKEN>"

# Optional: Guild ID for faster command sync (instant vs ~1 hour for global)
# Right-click server > Copy Server ID (Developer Mode must be ON)
DISCORD_CSCM_GUILD_ID=""

# Binance API (optional - for higher rate limits)
# Public endpoints work without authentication, but authenticated requests
# get higher rate limits. Get keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# CSCM strategy configuration
CSCM_REBALANCE_DAY="monday"

# ============================================================================
# DATABENTO FUTURES DATA (for futures data download from CME/GLBX.MDP3)
# ============================================================================
# Get your API key from: https://databento.com/portal
DATABENTO_API_KEY="<YOUR_DATABENTO_API_KEY>"

# ============================================================================
# IBKR GATEWAY (Interactive Brokers via IB Gateway + IBC)
# ============================================================================
# IB Gateway connection settings (used by IBKRBroker)
# Download IB Gateway from: https://www.interactivebrokers.com/en/trading/ibgateway-stable.php
IBKR_HOST="127.0.0.1"
IBKR_PORT="4002"
IBKR_CLIENT_ID="10"

# IBC automated login credentials (used by homeguard-gateway.service on EC2)
# These are your Interactive Brokers account credentials
IBKR_USERNAME="<YOUR_IBKR_USERNAME>"
IBKR_PASSWORD="<YOUR_IBKR_PASSWORD>"
IBKR_TRADING_MODE="paper"
IBKR_GATEWAY_PORT="4002"

# ============================================================================
# MONITORING (Prometheus/Grafana/Tailscale)
# ============================================================================
# In-process metrics exporter per-strategy
ENABLE_METRICS=true
# METRICS_PORT=8081  # Auto-assigned per strategy; override if needed

# Grafana admin password (used by install_grafana.sh)
# GRAFANA_ADMIN_PASSWORD=<your-password>

# Grafana service-account API token (used by scripts/ops/sync_grafana_annotations.py)
# Generate via Grafana UI: Administration -> Service accounts
# GRAFANA_API_KEY=<your-service-account-token>

# Tailscale auth key for private access to Grafana/VM UI
# Generate at: https://login.tailscale.com/admin/settings/keys
# TAILSCALE_AUTH_KEY=tskey-auth-...
