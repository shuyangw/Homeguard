[windows]
local_storage_dir = H:\Stock_Data
options_data_dir = H:\Stock_Data\options
output_dir = H:\Homeguard_Output
discord_bot_log_dir = H:\Homeguard_Output\discord_bot
api_threads = 8

[linux]
local_storage_dir = /home/user/stock_data
options_data_dir = /home/user/options_data
output_dir = /home/user/logs
discord_bot_log_dir = /home/user/logs/discord_bot
api_threads = 8

[tearsheets]
# Frequency for tearsheet data resampling to reduce file size
# Options: full (no resampling), H (hourly), D (daily), W (weekly)
frequency = H
